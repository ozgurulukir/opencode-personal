#!/usr/bin/env bash

# Get the latest Git tag
latest_tag=$(git tag --sort=committerdate | grep -E '^github-v[0-9]+\.[0-9]+\.[0-9]+$' | tail -1)
if [ -z "$latest_tag" ]; then
    echo "No tags found"
    exit 1
fi
echo "Latest tag: $latest_tag"

# Update latest tag atomically: force-move the local tag and force-push the ref in one
# operation, so consumers pinned to @latest never see a window where the tag is missing.
git tag -f -a latest $latest_tag -m "Update latest to $latest_tag"
git push --force origin refs/tags/latest