      "filePath": "packages/opencode/src/server/routes/instance/httpapi/middleware/cors-vary.ts",
      "summary": "Global middleware patching effect-smol CORS preflight responses to append Vary: Origin, preventing shared caches from reusing a dynamic-origin preflight response across different origins.",
      "tags": ["middleware", "cors", "caching", "workaround"],
      "complexity": "simple",
      "languageNotes": "Documents an upstream bug where HttpMiddleware.cors spreads allowOrigin() and allowHeaders() into one record, letting the second Vary header overwrite the first."
    },
