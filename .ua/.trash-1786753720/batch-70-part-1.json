    {
      "id": "file:packages/opencode/src/server/routes/instance/httpapi/lifecycle.ts",
      "type": "file",
      "name": "lifecycle.ts",
      "filePath": "packages/opencode/src/server/routes/instance/httpapi/lifecycle.ts",
      "summary": "Instance lifecycle helpers that mark instances for disposal or reload after the HTTP response is sent, handing teardown from the endpoint handler to the outer disposeMiddleware via a WeakMap keyed by the original Request object.",
      "tags": ["middleware", "lifecycle", "server", "resource-cleanup"],
      "complexity": "moderate",
      "languageNotes": "Uses a WeakMap keyed by the raw Request plus HttpEffect.appendPreResponseHandler so disposal runs only after the response has been written — a clean handoff between endpoint and server middleware."
    },
    {
      "id": "file:packages/opencode/src/server/routes/instance/httpapi/middleware/authorization.ts",
      "type": "file",
      "name": "authorization.ts",
      "filePath": "packages/opencode/src/server/routes/instance/httpapi/middleware/authorization.ts",
      "summary": "Authorization middleware validating Basic credentials from the Authorization header or auth_token query parameter against ServerAuth, with bypasses for public UI paths and PTY connect tickets; exported as both an HttpApiMiddleware layer and a raw router middleware.",
      "tags": ["middleware", "security", "authentication", "httpapi"],
      "complexity": "moderate",
      "languageNotes": "Deliberately avoids HttpApiSecurity alternatives: Effect security middleware wraps the whole handler, so a downstream failure could trigger the next auth alternative and remap an authorized 404 into a 401."
    },
