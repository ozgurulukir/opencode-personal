      "filePath": "packages/opencode/src/server/routes/instance/httpapi/handlers/session.ts",
      "summary": "Registers the session HTTP API group with 28 endpoints covering session CRUD, paginated messages, prompting (sync/async), sharing, compaction, revert, permission replies, and message/part editing, delegating to Session, SessionPrompt, SessionShare, and sibling services.",
