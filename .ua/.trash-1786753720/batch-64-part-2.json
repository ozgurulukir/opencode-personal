      "filePath": "packages/opencode/src/permission/arity.ts",
      "summary": "Provides command-prefix arity lookup for bash commands: the longest matching prefix wins, so `git checkout main` resolves to the two-token human-readable command used to build permission patterns.",
      "tags": ["utility", "bash", "permissions", "lookup-table"],
      "complexity": "moderate",
      "languageNotes": "The ARITY dictionary was LLM-generated from a strict prompt; flags never count as tokens and only subcommands extend the arity."
