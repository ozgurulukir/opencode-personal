    {
      "id": "file:packages/opencode/src/permission/index.ts",
      "type": "file",
      "name": "index.ts",
      "filePath": "packages/opencode/src/permission/index.ts",
      "summary": "The permission engine (@opencode/Permission): ask() evaluates config rules against DB-persisted approvals (deny always wins) and waits on a Deferred with a 5-minute timeout that broadcasts a synthetic reject; reply() resolves prompts, cascades rejects across the session, and transactionally persists 'always allow' rules. Also defines the Action/Rule/Ruleset schemas, tagged error classes, and the disabled() catch-all-deny tool filter.",
      "tags": ["service", "permissions", "security", "effect", "policy-engine"],
      "complexity": "complex",
      "languageNotes": "Uses Effect.raceFirst (not Effect.race) so the timeout branch's failure wins over a still-pending Deferred.await; approved rulesets are snapshot before the DB upsert to stay atomic under cooperative scheduling."
    },
