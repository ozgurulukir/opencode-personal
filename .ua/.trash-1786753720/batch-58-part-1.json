      "name": "sdk.tsx",
      "filePath": "packages/opencode/src/cli/cmd/tui/context/sdk.tsx",
      "summary": "SDK context that creates the opencode client and maintains the server-sent events connection — queues incoming events, flushes them in batches to avoid per-event churn, and reconnects with exponential backoff.",
      "tags": ["context-provider", "sdk-client", "sse", "event-stream", "reconnection"],
      "complexity": "moderate",
      "languageNotes": "The SSE loop wraps sdk.global.event with retryDelay * 2^(attempt-1) backoff capped at maxRetryDelay; queued events flush on a debounce timer so bursts coalesce into single store updates."
    },
