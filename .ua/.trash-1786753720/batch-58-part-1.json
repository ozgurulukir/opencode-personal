    {
      "id": "file:packages/opencode/src/cli/cmd/tui/context/sync.tsx",
      "type": "file",
      "name": "sync.tsx",
      "filePath": "packages/opencode/src/cli/cmd/tui/context/sync.tsx",
      "summary": "The TUI's main state bootstrap — orchestrates blocking requests (providers, agents, config, sessions) and non-blocking status fetches (commands, LSP, MCP, resources, formatter, session status, auth, VCS) into the SyncStore, with aggregated failure reporting and on-demand full sync of individual sessions.",
      "tags": ["context-provider", "state-management", "data-fetching", "bootstrap", "sdk-client"],
      "complexity": "complex",
      "languageNotes": "Bootstrap distinguishes blocking vs non-blocking requests via Promise.allSettled plus an aggregateFailures helper so one rejected endpoint surfaces a labeled message instead of drowning siblings as unhandled rejections; store status progresses loading → partial → complete."
    },
    {
