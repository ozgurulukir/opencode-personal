      "filePath": "packages/opencode/src/cli/cmd/tui/stderr-capture.ts",
      "lineRange": [46, 70],
      "summary": "Serializes an arbitrary console argument (errors with chained causes, arrays, objects) into a log-safe JSON string with String() fallbacks for non-serializable values.",
      "tags": ["serialization", "logging", "utility"],
      "complexity": "simple"
    },
    {
