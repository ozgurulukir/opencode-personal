      "id": "file:packages/opencode/src/cli/cmd/tui/stderr-capture.ts",
      "type": "file",
      "name": "stderr-capture.ts",
      "filePath": "packages/opencode/src/cli/cmd/tui/stderr-capture.ts",
      "summary": "Redirects process.stderr.write and all console.* methods into the log file during TUI rendering so stray output cannot corrupt the alternate screen; stdout is deliberately left untouched for OSC 52 clipboard escape sequences.",
      "tags": ["utility", "logging", "terminal", "io-capture"],
      "complexity": "moderate",
      "languageNotes": "Bun's optimized console writes directly to file descriptors, bypassing process.stderr.write, so both layers must be patched; capture/restore are idempotent via a saved original reference."
    },
    {
      "id": "function:packages/opencode/src/cli/cmd/tui/stderr-capture.ts:formatValue",
