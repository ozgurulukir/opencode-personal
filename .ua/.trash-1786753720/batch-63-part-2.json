      "name": "id.ts",
      "filePath": "packages/opencode/src/id/id.ts",
      "summary": "Monotonic prefixed ID generator (ses_, msg_, prt_, ...) producing 26-character base62 IDs whose lexicographic order matches creation time in the chosen direction, with per-millisecond counters for uniqueness and a timestamp extractor.",
      "tags": ["utility", "id-generation", "sorting"],
      "complexity": "moderate",
      "languageNotes": "Ascending IDs embed a BigInt-computed timestamp offset so lexicographic sort equals chronological order; a module-level lastTimestamp/counter pair keeps same-millisecond IDs strictly monotonic."
    },
