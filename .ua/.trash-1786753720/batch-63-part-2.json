      "name": "dedupeDiagnostics",
      "filePath": "packages/opencode/src/lsp/client.ts",
      "lineRange": [114, 131],
      "summary": "Deduplicates diagnostics by JSON-stringified identity, preserving first-occurrence order.",
      "tags": ["lsp", "utility", "diagnostics"],
      "complexity": "simple"
    },
    {
      "id": "function:packages/opencode/src/lsp/client.ts:create",
