      "id": "file:packages/opencode/src/index.ts",
      "type": "file",
      "name": "index.ts",
      "filePath": "packages/opencode/src/index.ts",
      "summary": "CLI entry point: configures a strict yargs CLI wiring 24 subcommands (run, serve, tui attach, acp, mcp, models, upgrade, ...), initializes logging and process metadata, runs the one-time JSON-to-SQLite migration with a terminal progress bar, and centralizes fatal error formatting.",
      "tags": ["entry-point", "cli", "yargs", "bootstrap"],
      "complexity": "complex",
      "languageNotes": "Raises EventEmitter.defaultMaxListeners to 100 to absorb AbortSignal.any listener accumulation; an explicit process.exit in the finally block avoids hangs from signal-ignoring MCP subprocesses."
    },
