      "filePath": "packages/opencode/src/lsp/client.ts",
      "lineRange": [149, 765],
      "summary": "Constructs the full LSP client: message connection over stdio, initialize handshake, notification and request handlers (configuration, dynamic registration, watched files), push/pull diagnostic machinery with debouncing and timeouts, notify open/change/close, touchFile, diagnostics accessors, and shutdown cleanup of all bounded maps.",
      "tags": ["lsp", "client", "factory", "diagnostics"],
      "complexity": "complex"
    },
