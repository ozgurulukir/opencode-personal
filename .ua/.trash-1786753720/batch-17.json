      "tags": ["configuration", "bun", "test-runner", "preload"],
      "complexity": "simple",
      "languageNotes": "bunfig.toml's [test] timeout key is not actually parsed by Bun (oven-sh/bun#7789), so the test timeout is passed via --timeout in package.json scripts instead."
    },
    {
      "id": "config:packages/opencode/package.json",
