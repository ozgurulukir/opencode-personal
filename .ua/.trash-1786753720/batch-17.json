      "filePath": "packages/opencode/package.json",
      "summary": "Manifest for the opencode core package: defines the opencode CLI binary, dev/build/test/typecheck scripts (tsgo, bun test with junit CI reporting, compile-mode builds), wildcard src exports, and the full Effect / AI-sdk / OpenTUI / drizzle dependency set managed via workspace catalog versions.",
      "tags": ["configuration", "package-manifest", "build-system", "dependencies", "cli"],
      "complexity": "moderate",
      "languageNotes": "Uses Node subpath imports (#db, #pty, #httpapi-server) with bun/node runtime conditions for platform-specific module resolution, plus catalog: version references resolved by the Bun workspace root."
    },
