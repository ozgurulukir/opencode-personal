      "type": "file",
      "name": "event.ts",
      "filePath": "packages/opencode/src/server/routes/instance/httpapi/event.ts",
      "summary": "Per-instance SSE endpoint (GET /event): declares the EventApi group and implements its handler, streaming raw Bus events (id/type/properties) plus synthetic server.connected and 10-second heartbeat events through the SSE encoder with no-cache/nosniff headers.",
      "tags": ["api-handler", "sse", "streaming", "event-handler", "httpapi"],
      "complexity": "moderate",
      "languageNotes": "Uses handlers.handleRaw because the SSE response bypasses the schema-typed success channel; the stream terminates when the Bus emits InstanceDisposed."
    },
    {
      "id": "function:packages/opencode/src/server/routes/instance/httpapi/event.ts:eventResponse",
