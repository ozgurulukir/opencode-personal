    {
      "id": "file:packages/opencode/src/server/mdns.ts",
      "type": "file",
      "name": "mdns.ts",
      "filePath": "packages/opencode/src/server/mdns.ts",
      "summary": "Publishes the opencode HTTP server over mDNS/Bonjour as `opencode-{port}` (type http, host opencode.local or a custom domain) with exponential-backoff retry up to 3 attempts, and unpublishes/destroys the advertiser on shutdown.",
      "tags": ["networking", "mdns", "service-discovery", "retry", "server"],
      "complexity": "moderate",
      "languageNotes": "Uses `InstanceType<typeof Bonjour>` for type annotations because bonjour-service's CommonJS `export =` cannot be used as a type under esModuleInterop."
    },
    {
      "id": "function:packages/opencode/src/server/mdns.ts:publish",
      "type": "function",
      "name": "publish",
      "filePath": "packages/opencode/src/server/mdns.ts",
      "lineRange": [12, 56],
      "summary": "Publishes the opencode mDNS service (name `opencode-{port}`, txt path=/), no-op when the port is unchanged, with exponential backoff (500ms base, doubling) across at most 3 retry attempts before giving up permanently.",
      "tags": ["networking", "mdns", "retry", "service-discovery"],
      "complexity": "moderate"
    },
    {
      "id": "function:packages/opencode/src/server/mdns.ts:unpublish",
      "type": "function",
      "name": "unpublish",
      "filePath": "packages/opencode/src/server/mdns.ts",
      "lineRange": [58, 70],
      "summary": "Unpublishes all mDNS services, destroys the Bonjour advertiser, and resets the module-level port/state tracking.",
      "tags": ["networking", "mdns", "cleanup"],
      "complexity": "simple"
    },
