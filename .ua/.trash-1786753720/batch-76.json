      "name": "auth.ts",
      "filePath": "packages/opencode/src/v2/auth.ts",
      "summary": "V2 authentication service managing OAuth and API-key accounts in an auth-v2.json store, with automatic migration from the v1 flat credential map, per-service active-account tracking, and SynchronizedRef-guarded persistence written with 0o600 permissions.",
