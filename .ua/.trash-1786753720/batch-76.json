    {
      "id": "file:packages/opencode/src/v2/session.ts",
      "type": "file",
      "name": "session.ts",
      "filePath": "packages/opencode/src/v2/session.ts",
      "summary": "The V2 session service — a stable two-layer facade where reads (get/list/messages/context) query SessionTable and SessionMessageTable directly via Drizzle, while writes (create/prompt/shell/skill/subagent/compact) delegate to V1 services that own the agent loop; adds deferred prompt delivery and subagent orchestration with permission fallbacks and nesting limits.",
