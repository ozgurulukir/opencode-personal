      "id": "file:packages/opencode/src/search/zvec.ts",
      "type": "file",
      "name": "zvec.ts",
      "filePath": "packages/opencode/src/search/zvec.ts",
      "summary": "Implements SearchService on the native zvec vector database: lazy-loads the platform binding, manages collection lifecycle (create/open/dimension migration), and wires an Effect layer with per-instance index state under the global cache directory.",
      "tags": ["service", "search", "vector-database", "native-binding", "effect"],
      "complexity": "complex",
      "languageNotes": "A template `require(`@zvec/bindings-${process.platform}-${process.arch}`)` is statically analyzable by Bun --compile so the .node addon is embedded in the standalone binary; the @zvec/zvec JS wrapper is bypassed because its runtime require.resolve cannot resolve inside the compiled binary's virtual filesystem."
    },
