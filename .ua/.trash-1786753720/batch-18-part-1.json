  "nodes": [
    {
      "id": "document:packages/opencode/specs/effect/errors.md",
      "type": "document",
      "name": "errors.md",
      "filePath": "packages/opencode/specs/effect/errors.md",
      "summary": "Design spec for migrating packages/opencode from NamedError/defect compatibility bridges to typed Effect service errors and explicit HTTP error contracts. Defines the Schema.TaggedErrorClass authoring rules, the HttpApi boundary error module, a six-phase migration plan, and per-domain conversion priorities for storage, worktree, provider, MCP, skill, LSP, and IDE services.",
      "tags": ["documentation", "error-handling", "effect", "http-api", "migration-plan"],
      "complexity": "complex",
      "languageNotes": "Central pattern: Schema.TaggedErrorClass with an httpApiStatus annotation so Effect HttpApiBuilder and OpenAPI generation derive the HTTP status directly from the error schema instead of a parallel name-to-status map."
    },
    {
      "id": "document:packages/opencode/specs/effect/facades.md",
      "type": "document",
      "name": "facades.md",
      "filePath": "packages/opencode/specs/effect/facades.md",
      "summary": "Working checklist for removing makeRuntime-backed async service facades in packages/opencode, replacing Namespace.method() calls with AppRuntime.runPromise(Effect.gen(...)) bodies and yield*-style service access. Tracks the two merged cleanup waves (Pty, Skill, Vcs, ToolRegistry, Auth, Config, Provider, File, LSP, MCP), caller/test conversion templates, and the remaining hotspots in the TUI config and instance plumbing.",
      "tags": ["documentation", "effect", "refactoring-checklist", "service-layer", "migration-plan"],
      "complexity": "moderate"
    },
    {
      "id": "document:packages/opencode/specs/effect/instance-context.md",
      "type": "document",
      "name": "instance-context.md",
      "filePath": "packages/opencode/specs/effect/instance-context.md",
      "summary": "Phased plan for retiring the promise-backed/ALS-backed Instance helper in src/project/instance.ts and moving instance selection into Effect-provided scope via InstanceRef/WorkspaceRef and a scoped per-directory runtime. Includes a 56-file inventory of direct Instance.* usage across HTTP, CLI, TUI, tool, and service boundaries, ranked by churn.",
      "tags": ["documentation", "effect", "migration-plan", "instance-context", "refactoring-checklist"],
      "complexity": "complex",
      "languageNotes": "Documents the AsyncLocalStorage-to-Effect-context transition: ALS survives only as a bridge for native callbacks firing outside the Effect fiber tree, with per-directory boot handled by ScopedCache keyed layers instead of a module-level promise Map."
    },
    {
      "id": "document:packages/opencode/specs/effect/loose-ends.md",
      "type": "document",
      "name": "loose-ends.md",
      "filePath": "packages/opencode/specs/effect/loose-ends.md",
      "summary": "Short follow-up list for Effect migration items that do not fit the main facade, route, tool, or schema checklists: finishing the internal Effect migration of the TUI config service, splitting pure from effectful helpers in config/paths.ts behind a ConfigPaths.Service, and continued shrinking of the legacy instance helper.",
      "tags": ["documentation", "effect", "checklist", "follow-ups", "configuration"],
      "complexity": "simple"
    },
    {
      "id": "document:packages/opencode/specs/effect/migration.md",
      "type": "document",
      "name": "migration.md",
      "filePath": "packages/opencode/specs/effect/migration.md",
      "summary": "Practical reference for Effect patterns in packages/opencode: the canonical service module shape (Context.Service tag, Effect.fn-traced methods, InstanceState for per-directory state), Schema-to-Zod interop via the zod() helper, Effect.cached deduplication, preferred platform services, and a ~40-module service-shape migration checklist with a facade-destruction playbook and pitfalls.",
      "tags": ["documentation", "effect", "patterns", "service-layer", "reference"],
      "complexity": "complex",
      "languageNotes": "Codifies the repo's Effect conventions: InstanceState.make closures receive a Scope so acquireRelease/forkScoped resources are cleaned up by ScopedCache on disposal, and Effect.cached replaces hand-rolled Promise/fiber memoization for concurrent deduplication."
    }
  ],
