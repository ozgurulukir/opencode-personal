    {
      "id": "file:packages/web/src/components/share/part.tsx",
      "type": "file",
      "name": "part.tsx",
      "filePath": "packages/web/src/components/share/part.tsx",
      "summary": "Core renderer for a single message part in the share view: dispatches on part type and tool name to dedicated tool cards (grep, glob, list, read, write, edit, bash, todowrite, webfetch, task, plus a generic fallback), decorates each part with a copy-link anchor and role/provider icon, and appends footers with locale-aware timestamps and durations.",
      "tags": ["component", "share-view", "message-rendering", "tool-renderer", "dispatcher"],
      "complexity": "complex",
      "languageNotes": "A single SolidJS <Switch> over (role, part.type, tool) triples acts as the dispatch table; ProviderIcon guesses the vendor purely from the model ID string via regex, and typed MessageV2 part shapes come from the opencode package itself."
    },
    {
      "id": "file:packages/web/src/content.config.ts",
      "type": "file",
      "name": "content.config.ts",
      "filePath": "packages/web/src/content.config.ts",
      "summary": "Astro content collections configuration: registers the Starlight docs loader and an i18n collection whose schema is extended with every key from en.json so custom share.* UI strings typecheck across all locales.",
      "tags": ["configuration", "astro", "i18n", "content-collections"],
      "complexity": "simple",
      "languageNotes": "Derives the schema extension programmatically — Object.fromEntries over en.json keys — so adding a UI string to en.json automatically widens the i18n schema, with z.string() catchall for locales that are not yet fully translated."
    },
