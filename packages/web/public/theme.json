        },
        "syntaxComment": {
          "$ref": "#/$defs/__schema1"
        },
        "syntaxKeyword": {
          "$ref": "#/$defs/__schema1"
        },
        "syntaxFunction": {
          "$ref": "#/$defs/__schema1"
        },
        "syntaxVariable": {
          "$ref": "#/$defs/__schema1"
        },
        "syntaxString": {
          "$ref": "#/$defs/__schema1"
        },
        "syntaxNumber": {
          "$ref": "#/$defs/__schema1"
        },
        "syntaxType": {
          "$ref": "#/$defs/__schema1"
        },
        "syntaxOperator": {
          "$ref": "#/$defs/__schema1"
        },
        "syntaxPunctuation": {
          "$ref": "#/$defs/__schema1"
        },
        "selectedListItemText": {
          "$ref": "#/$defs/__schema1"
        },
        "backgroundMenu": {
          "$ref": "#/$defs/__schema1"
        },
        "thinkingOpacity": {
          "type": "number"
        }
      },
      "required": [
        "primary",
        "secondary",
        "accent",
        "error",
        "warning",
        "success",
        "info",
        "text",
        "textMuted",
        "background",
        "backgroundPanel",
        "backgroundElement",
        "border",
        "borderActive",
        "borderSubtle",
        "diffAdded",
        "diffRemoved",
        "diffContext",
        "diffHunkHeader",
        "diffHighlightAdded",
        "diffHighlightRemoved",
        "diffAddedBg",
        "diffRemovedBg",
        "diffContextBg",
        "diffLineNumber",
        "diffAddedLineNumberBg",
        "diffRemovedLineNumberBg",
        "markdownText",
        "markdownHeading",
        "markdownLink",
        "markdownLinkText",
        "markdownCode",
        "markdownBlockQuote",
        "markdownEmph",
        "markdownStrong",
        "markdownHorizontalRule",
        "markdownListItem",
        "markdownListEnumeration",
        "markdownImage",
        "markdownImageText",
        "markdownCodeBlock",
        "syntaxComment",
        "syntaxKeyword",
        "syntaxFunction",
        "syntaxVariable",
        "syntaxString",
        "syntaxNumber",
        "syntaxType",
        "syntaxOperator",
        "syntaxPunctuation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "theme"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "string",
          "const": "none"
        },
        {
          "type": "string",
          "const": "transparent"
        },
        {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "object",
          "properties": {
            "dark": {
              "$ref": "#/$defs/__schema0"
            },
            "light": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "dark",
            "light"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}