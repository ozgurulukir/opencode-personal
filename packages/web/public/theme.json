{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCode TUI Theme",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "defs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "primary": {
          "$ref": "#/$defs/__schema1"
        },
        "secondary": {
          "$ref": "#/$defs/__schema1"
        },
        "accent": {
          "$ref": "#/$defs/__schema1"
        },
        "error": {
          "$ref": "#/$defs/__schema1"
        },
        "warning": {
          "$ref": "#/$defs/__schema1"
        },
        "success": {
          "$ref": "#/$defs/__schema1"
        },
        "info": {
          "$ref": "#/$defs/__schema1"
        },
        "text": {
          "$ref": "#/$defs/__schema1"
        },
        "textMuted": {
          "$ref": "#/$defs/__schema1"
        },
        "background": {
          "$ref": "#/$defs/__schema1"
        },
        "backgroundPanel": {
          "$ref": "#/$defs/__schema1"
        },
        "backgroundElement": {
          "$ref": "#/$defs/__schema1"
        },
        "border": {
          "$ref": "#/$defs/__schema1"
        },
        "borderActive": {
          "$ref": "#/$defs/__schema1"
        },
        "borderSubtle": {
          "$ref": "#/$defs/__schema1"
        },
        "diffAdded": {
          "$ref": "#/$defs/__schema1"
        },
        "diffRemoved": {
          "$ref": "#/$defs/__schema1"
        },
        "diffContext": {
          "$ref": "#/$defs/__schema1"
        },
        "diffHunkHeader": {
          "$ref": "#/$defs/__schema1"
        },
        "diffHighlightAdded": {
          "$ref": "#/$defs/__schema1"
        },
        "diffHighlightRemoved": {
          "$ref": "#/$defs/__schema1"
        },
        "diffAddedBg": {
          "$ref": "#/$defs/__schema1"
        },
        "diffRemovedBg": {
          "$ref": "#/$defs/__schema1"
        },
        "diffContextBg": {
          "$ref": "#/$defs/__schema1"
        },
        "diffLineNumber": {
          "$ref": "#/$defs/__schema1"
        },
        "diffAddedLineNumberBg": {
          "$ref": "#/$defs/__schema1"
        },
        "diffRemovedLineNumberBg": {
          "$ref": "#/$defs/__schema1"
        },
        "markdownText": {
          "$ref": "#/$defs/__schema1"
        },
        "markdownHeading": {
          "$ref": "#/$defs/__schema1"
        },
        "markdownLink": {
          "$ref": "#/$defs/__schema1"
        },
        "markdownLinkText": {
          "$ref": "#/$defs/__schema1"
        },
        "markdownCode": {
          "$ref": "#/$defs/__schema1"
        },
        "markdownBlockQuote": {
          "$ref": "#/$defs/__schema1"
        },
        "markdownEmph": {
          "$ref": "#/$defs/__schema1"
        },
        "markdownStrong": {
          "$ref": "#/$defs/__schema1"
        },
        "markdownHorizontalRule": {
          "$ref": "#/$defs/__schema1"
        },
        "markdownListItem": {
          "$ref": "#/$defs/__schema1"
        },
        "markdownListEnumeration": {
          "$ref": "#/$defs/__schema1"
        },
        "markdownImage": {
          "$ref": "#/$defs/__schema1"
