---
import { getRelativeLocaleUrl } from "astro:i18n"

const locale = Astro.currentLocale || "root"
const docsUrl = getRelativeLocaleUrl(locale, "config")
---

<main class="landing">
  <p class="eyebrow">Personal fork</p>
  <h1>OpenCode</h1>
  <p class="intro">An independently maintained personal fork of the open source AI coding agent.</p>
  <p class="actions">
    <a class="primary" href={docsUrl}>Read the documentation</a>
    <a href="https://github.com/ozgurulukir/opencode-personal">View the source on GitHub</a>
  </p>
  <p class="upstream">A personal fork of <a href="https://github.com/anomalyco/opencode">OpenCode</a>, maintained independently.</p>
</main>

<style>
  .landing {
    max-width: 52rem;
    margin: 10vh auto;
    padding: 2rem;
  }

  .eyebrow {
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin-block: 0.5rem;
    font-size: clamp(3rem, 10vw, 6rem);
  }

  .intro {
    max-width: 36rem;
    color: var(--sl-color-text-secondary);
    font-size: var(--sl-text-xl);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-block: 2rem;
  }

  .actions a {
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    text-decoration: none;
  }

  .actions .primary {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
  }

  .upstream {
    color: var(--sl-color-text-dimmed);
    font-size: var(--sl-text-sm);
  }
</style>
